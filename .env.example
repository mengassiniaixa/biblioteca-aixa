# Copiar como `.env` y ajustar. docker compose lo lee automaticamente.

# --- Postgres ---
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=biblioteca
POSTGRES_DB=biblioteca
# Solo se usa si descomentas 'ports' del servicio db en docker-compose.yml
# (para conectar pgAdmin/psql desde el host). El backend NO lo necesita.
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
JWT_SECRET=dev-only-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
SEED_LIBRARIAN_NAME=Bibliotecaria
SEED_LIBRARIAN_EMAIL=librarian@biblioteca.local
SEED_LIBRARIAN_PASSWORD=librarian123
SEED_DEMO_OVERDUE=false

# --- Frontend ---
FRONTEND_PORT=8080
# URL que el browser usa para pegarle al backend (build-time de Vite)
VITE_API_BASE_URL=http://localhost:3000
